;; ac.il -- AutoCircuit entry point. Loads the PDK config, the helper libraries
;; and every circuit script.
;;
;; In the CIW, one line does everything for a job (pull, reload, run, report):
;;   load("~/AutoCircuit/ac.il") acGo("p1a")
;; Just reload the latest scripts:
;;   acReload()
;; Over SSH (no GUI):
;;   ~/AutoCircuit/run.sh p1a

acRoot = or(getShellEnvVar("AC_ROOT") strcat(getShellEnvVar("HOME") "/AutoCircuit"))

;; order matters: PDK config, then libraries, then circuits
acFiles = '("pdk_cmrf7sf.il" "lib_draw.il" "lib_sim.il" "lib_ade.il"
            "cs_amp.il" "cs_wsweep.il"
            "hw1_p1a.il" "rf_cap.il" "rf_ind.il" "gmid.il" "wsub.il" "hw1_setup.il" "sps.il" "spsg.il" "hw2_setup.il" "hw3_setup.il"
            "ece203_lib.il" "ece203_hp.il" "ece203_ideal.il" "ece203_ota.il" "ece203_noise_scan.il" "ece203_load.il" "ece203_ss.il" "ece203_ss_lscan.il" "ece203_ss_pr.il" "ece203_ss_otacmp.il" "ece203_ss_chop.il" "ece203_ss_chop_noise.il" "ece203_r4.il" "ece203_r5.il" "ece203_r6a.il" "ece203_r6b.il" "ece203_r5n.il" "ece203_r5nl.il" "ece203_r5nn.il" "ece203_r5nf.il" "ece203_r6c.il" "ece203_r6d.il" "ece203_r6dr.il" "ece203_r7a.il" "ece203_r7b.il" "ece203_r7c.il" "ece203_r7d.il" "ece203_r7e.il" "ece203_r7f.il" "ece203_r8_noise.il" "ece203_r8b.il" "ece203_r8c.il" "ece203_r8d.il" "ece203_r8e.il" "ece203_f2i.il")

